{
  "name": "released-app-dev-mcp",
  "version": "0.2.0",
  "description": "MCP server that owns the Git/GitHub release workflow of iOS apps already published on the App Store — small and large branch strategies in one server.",
  "type": "module",
  "bin": {
    "released-app-dev-mcp": "./dist/index.js",
    "small-app-dev-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test \".tests-build/tests/*.test.js\""
  },
  "dependencies": {
    "@app-dev/git-core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2",
    "@types/js-yaml": "^4.0.9"
  }
}
