{
  "name": "small-app-dev-mcp",
  "version": "0.1.0",
  "description": "MCP server for safe, simple Git/GitHub/release automation for small-scale and indie iOS app development — not for large team Git Flow",
  "type": "module",
  "bin": {
    "small-app-dev-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@app-dev/git-core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2",
    "@types/js-yaml": "^4.0.9"
  }
}
